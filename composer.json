{
    "name": "bytexr/laravel-dynamic-reporter",
    "version": "3.0.0-dev",
    "description": "A Laravel package that allows users to build custom reports from Eloquent models safely",
    "keywords": [
        "laravel",
        "reports",
        "dynamic-reporter",
        "eloquent",
        "filament"
    ],
    "homepage": "https://github.com/bytexr/laravel-reports",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "ByteXR",
            "email": "info@bytexr.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "dragonmantank/cron-expression": "^3.3",
        "filament/filament": "^3.0",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0",
        "spatie/simple-excel": "^3.0"
    },
    "suggest": {
        "google/apiclient": "Required for Google Drive export functionality",
        "leandrocfe/filament-apex-charts": "Required for chart visualization functionality",
        "barryvdh/laravel-dompdf": "Required for PDF export functionality"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "ByteXR\\DynamicReporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ByteXR\\DynamicReporter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "ByteXR\\DynamicReporter\\DynamicReporterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
